    layout {
        gaps 3 // Gap between windows
        center-focused-column "never" // Don't auto-center focused column

        background-color "transparent" // <- needed for noctalia-shell to set wallpaper

        focus-ring {
            width 1
            active-color "#98c379"
            inactive-color "#5c6370"
        }

        border {
            width 1
            active-color "#98c379"
            inactive-color "#5c6370"
        }

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
        }

        struts {}
    }
